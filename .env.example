# NEXORA System Configuration
NEXORA_ENV=development
NEXORA_LOG_LEVEL=debug
NEXORA_HTTP_PORT=8080
NEXORA_HTTP_READ_TIMEOUT=15s
NEXORA_HTTP_WRITE_TIMEOUT=30s
NEXORA_HTTP_SHUTDOWN_TIMEOUT=10s

# PostgreSQL 16
NEXORA_DB_HOST=localhost
NEXORA_DB_PORT=5432
NEXORA_DB_NAME=nexora
NEXORA_DB_USER=nexora_admin
NEXORA_DB_PASSWORD=nexora_secret_dev
NEXORA_DB_SSLMODE=disable
NEXORA_DB_MAX_CONNS=25
NEXORA_DB_MIN_CONNS=5
NEXORA_DB_MAX_CONN_LIFETIME=1h

# Redis 7
NEXORA_REDIS_HOST=localhost
NEXORA_REDIS_PORT=6379
NEXORA_REDIS_PASSWORD=nexora_redis_dev
NEXORA_REDIS_DB=0
